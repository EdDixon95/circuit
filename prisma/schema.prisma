// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries       CompetitionEntry[]
  gymStaffRoles GymStaff[]

  @@map("users")
}

model Gym {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  slug         String  @unique
  email        String? @unique
  phone        String?
  website      String?
  addressLine1 String? @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String?
  county       String?
  postcode     String?
  country      String?
  logoUrl      String? @map("logo_url")
  description  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  competitions Competition[]

  staff GymStaff[]

  @@map("gyms")
}

model Competition {
  id                String    @id @default(uuid()) @db.Uuid
  gymId             String    @map("gym_id") @db.Uuid
  name              String
  competitionTypeId String    @map("competition_type_id") @db.Uuid
  slug              String
  description       String?
  startDate         DateTime  @map("start_date")
  endDate           DateTime  @map("end_date")
  registrationOpen  DateTime? @map("registration_open")
  registrationClose DateTime? @map("registration_close")
  status            Status

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gym             Gym                @relation(fields: [gymId], references: [id])
  competitionType CompetitionType    @relation(fields: [competitionTypeId], references: [id])
  entries         CompetitionEntry[]

  categories CompetitionCategory[]
  problems   CompetitionProblem[]

  @@unique([gymId, slug])
  @@map("competitions")
}

enum Status {
  DRAFT
  OPEN
  LIVE
  FINISHED
  ARCHIVED
}

model CompetitionType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  competitions Competition[]

  @@map("competition_types")
}

model CompetitionCategory {
  id            String  @id @default(uuid()) @db.Uuid
  competitionId String  @map("competition_id") @db.Uuid
  name          String
  description   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  competition Competition @relation(fields: [competitionId], references: [id])

  entries CompetitionEntry[]

  @@unique([competitionId, name])
  @@map("competition_categories")
}

model CompetitionProblem {
  id            String  @id @default(uuid()) @db.Uuid
  competitionId String  @map("competition_id") @db.Uuid
  problemNumber Int     @map("problem_number")
  grade         String?
  colour        ProblemColour?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  competition Competition @relation(fields: [competitionId], references: [id])

  attempts Attempt[]

  @@unique([competitionId, problemNumber])
  @@map("competition_problems")
}

model GymStaff {
  gymId  String    @map("gym_id") @db.Uuid
  userId String    @map("user_id") @db.Uuid
  role   StaffRole

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gym  Gym  @relation(fields: [gymId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([gymId, userId])
  @@map("gym_staff")
}

enum StaffRole {
  ADMIN
  STAFF
}

model CompetitionEntry {
  id            String    @id @default(uuid()) @db.Uuid
  competitionId String    @map("competition_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  registeredAt  DateTime  @default(now()) @map("registered_at")
  checkedInAt   DateTime? @map("checked_in_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  competition Competition          @relation(fields: [competitionId], references: [id])
  user        User                 @relation(fields: [userId], references: [id])
  category    CompetitionCategory @relation(fields: [categoryId], references: [id])

  attempts Attempt[]

  @@unique([competitionId, userId])
  @@map("competition_entries")
}

model Attempt {
  id                   String   @id @default(uuid()) @db.Uuid
  competitionEntryId   String   @map("competition_entry_id") @db.Uuid
  competitionProblemId String   @map("competition_problem_id") @db.Uuid
  attemptNumber        Int      @map("attempt_number")
  result               Result
  recordedAt           DateTime @default(now()) @map("recorded_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  entry   CompetitionEntry   @relation(fields: [competitionEntryId], references: [id])
  problem CompetitionProblem @relation(fields: [competitionProblemId], references: [id])

  @@unique([competitionEntryId, competitionProblemId, attemptNumber])
  @@map("attempts")
}

enum Result {
  TOP
  ZONE
  NONE
}

enum ProblemColour {
  WHITE
  BLACK
  RED
  ORANGE
  YELLOW
  GREEN
  BLUE
  PURPLE
  PINK
  BROWN
}
