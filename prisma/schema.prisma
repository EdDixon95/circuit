// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Gym {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  slug         String  @unique
  email        String? @unique
  phone        String?
  website      String?
  addressLine1 String? @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String?
  county       String?
  postcode     String?
  country      String?
  logoUrl      String? @map("logo_url")
  description  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  competitions Competition[]

  @@map("gyms")
}

model Competition {
  id                String    @id @default(uuid()) @db.Uuid
  gymId             String    @map("gym_id") @db.Uuid
  name              String
  competitionTypeId String    @map("competition_type_id") @db.Uuid
  slug              String
  description       String?
  startDate         DateTime  @map("start_date")
  endDate           DateTime  @map("end_date")
  registrationOpen  DateTime? @map("registration_open")
  registrationClose DateTime? @map("registration_close")
  status            Status

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gym             Gym             @relation(fields: [gymId], references: [id])
  competitionType CompetitionType @relation(fields: [competitionTypeId], references: [id])

  categories CompetitionCategory[]
  problems   CompetitionProblem[]

  @@unique([gymId, slug])
  @@map("competitions")
}

enum Status {
  DRAFT
  OPEN
  LIVE
  FINISHED
  ARCHIVED
}

model CompetitionType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  competitions Competition[]

  @@map("competition_types")
}

model CompetitionCategory {
  id            String  @id @default(uuid()) @db.Uuid
  competitionId String  @map("competition_id") @db.Uuid
  name          String
  description   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  competition Competition @relation(fields: [competitionId], references: [id])

  @@unique([competitionId, name])
  @@map("competition_categories")
}

model CompetitionProblem {
  id            String  @id @default(uuid()) @db.Uuid
  competitionId String  @map("competition_id") @db.Uuid
  problemNumber Int     @map("problem_number")
  grade         String?
  colour        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  competition Competition @relation(fields: [competitionId], references: [id])

  @@unique([competitionId, problemNumber])
  @@map("competition_problems")
}
